{
  "name": "locallens",
  "version": "1.2.0",
  "private": true,
  "description": "Private, offline-first Chrome extension for page translation and chat via local Ollama",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedshamc/LocalLens.git"
  },
  "keywords": [
    "chrome-extension",
    "ollama",
    "translation",
    "offline",
    "privacy"
  ],
  "author": "Saeed shamsi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/saeedshamc/LocalLens/issues"
  },
  "homepage": "https://github.com/saeedshamc/LocalLens#readme",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
